{
  "name": "bodime",
  "version": "2.0.0",
  "private": true,
  "description": "බෝඩිම — Bodime: boarding-house expense sharing PWA",
  "scripts": {
    "test": "node tests/run.js",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');const T={'.html':'text/html','.js':'text/javascript','.json':'application/json','.png':'image/png'};h.createServer((q,s)=>{const n=(q.url==='/'?'/index.html':q.url).split('?')[0];f.readFile(p.join(process.cwd(),p.basename(n)),(e,b)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{'Content-Type':T[p.extname(n)]||'text/plain','Cache-Control':'no-cache'});s.end(b)})}).listen(8099,()=>console.log('http://localhost:8099'))\""
  },
  "devDependencies": {
    "playwright": "^1.40.0"
  }
}
